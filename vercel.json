{
    "rewrites": [
        {
            "source": "/Summaries",
            "destination": "/summaries.html"
        },
        {
            "source": "/summaries",
            "destination": "/summaries.html"
        },
        {
            "source": "/((?!api|_next|static|assets|.*\\..*).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/Mahmoud%20Maher.jpg",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}